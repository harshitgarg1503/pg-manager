generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BedStatus {
  VACANT
  OCCUPIED
  RESERVED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String   @unique
  ownerName String
  phone     String
  upiId     String?
  noticePeriodDays Int @default(30)
  walletBalance Float @default(0)
  city String?
  state String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
  rooms      Room[]
  beds       Bed[]
  tenants    Tenant[]
  invoices   Invoice[]
  tickets    MaintenanceTicket[]
  announcements Announcement[]
  mealAttendances MealAttendance[]
  expenses Expense[]
  staff Staff[]
  walletTransactions WalletTransaction[]
}

model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  rooms Room[]

  @@index([organizationId])
  @@index([organizationId, name])
}

model Room {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomNumber     String
  floor          Int          @default(0)
  baseRent       Decimal      @db.Decimal(10, 2)
  airConditioned Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  beds    Bed[]
  tickets MaintenanceTicket[]

  @@unique([propertyId, roomNumber])
  @@index([organizationId])
  @@index([propertyId])
  @@index([organizationId, propertyId])
}

model Bed {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roomId         String
  room           Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedNumber      String
  status         BedStatus    @default(VACANT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant Tenant?

  @@unique([roomId, bedNumber])
  @@index([organizationId])
  @@index([roomId])
  @@index([organizationId, roomId])
  @@index([status])
}

model Tenant {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bedId            String?      @unique
  bed              Bed?         @relation(fields: [bedId], references: [id], onDelete: Restrict)
  fullName         String
  phone            String
  email            String?
  idProofUrl       String?
  checkInDate      DateTime     @default(now())
  emergencyContact String?
  noticeStatus       String    @default("NONE")
  noticeServedAt     DateTime?
  expectedVacateDate DateTime?
  vacateReason       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  invoices Invoice[]
  mealAttendances MealAttendance[]

  @@index([organizationId])
  @@index([bedId])
  @@index([organizationId, bedId])
  @@index([phone])
}

model Invoice {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month            Int
  year             Int
  roomRent         Decimal       @db.Decimal(10, 2)
  prevMeterReading Decimal?      @db.Decimal(10, 2)
  currMeterReading Decimal?      @db.Decimal(10, 2)
  electricityUnits Decimal       @default(0) @db.Decimal(10, 2)
  electricityAmount Decimal?     @db.Decimal(10, 2)
  totalAmount      Decimal       @db.Decimal(10, 2)
  status           InvoiceStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([tenantId, month, year])
  @@index([organizationId])
  @@index([tenantId])
  @@index([organizationId, tenantId])
  @@index([status])
  @@index([organizationId, status])
}

model MaintenanceTicket {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roomId         String
  room           Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  category       String
  description    String       @db.Text
  status         TicketStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([roomId])
  @@index([organizationId, roomId])
  @@index([status])
  @@index([organizationId, status])
}

model Announcement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  message        String
  priority       String       @default("NORMAL")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model MealAttendance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date           DateTime
  breakfast      Boolean      @default(true)
  lunch          Boolean      @default(true)
  dinner         Boolean      @default(true)
  updatedAt      DateTime     @updatedAt

  @@unique([tenantId, date])
  @@index([organizationId, date])
}

model Expense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  amount         Float
  category       String
  expenseDate    DateTime     @default(now())
  addedByRole    String       @default("OWNER")
  addedByName    String?
  status         String       @default("APPROVED")
  createdAt      DateTime     @default(now())

  @@index([organizationId, expenseDate])
}

model Staff {
  id                      String       @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                    String
  phone                   String
  email                   String?
  role                    String       @default("WARDEN")
  canManageMaintenance    Boolean      @default(true)
  canAddExpenses          Boolean      @default(true)
  canViewBeds             Boolean      @default(true)
  canViewTenantsEmergency Boolean      @default(true)
  active                  Boolean      @default(true)
  createdAt               DateTime     @default(now())
  loginEmail              String?      @unique
  password                String?

  @@index([organizationId])
}

model WalletTransaction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount         Float
  type           String
  description    String
  balanceAfter   Float
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}
