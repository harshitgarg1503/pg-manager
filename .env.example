# Copy to .env and fill in real values. Do not commit .env.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pg_manager"

# Supabase Auth (required for multi-tenant auth)
# Find these in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Secret service_role key — ONLY for server-side staff provisioning.
# NEVER prefix with NEXT_PUBLIC_. Find it in the same API settings page.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
